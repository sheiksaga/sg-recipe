---
import { getCollection, render } from 'astro:content';
import countries from 'i18n-iso-countries';
import enLocale from 'i18n-iso-countries/langs/en.json';
import Base from '../../layouts/Base.astro';
import OriginPlate from '../../components/OriginPlate.astro';

countries.registerLocale(enLocale);

export async function getStaticPaths() {
  const recipes = await getCollection('recipes');
  return recipes.map((recipe) => ({ params: { slug: recipe.id }, props: { recipe } }));
}

const { recipe } = Astro.props;
const { Content } = await render(recipe);
const d = recipe.data;

const countryNames = d.country.map((c: string) => countries.getName(c, 'en') ?? c).join(', ');

const groups = new Map<string, (string | { item: string; qty?: unknown; unit?: string; prep?: string; note?: string })[]>();
for (const ing of d.ingredients) {
  const g = typeof ing === 'string' ? '' : (ing.group ?? '');
  if (!groups.has(g)) groups.set(g, []);
  groups.get(g)!.push(ing);
}

function ingredientText(ing: unknown): string {
  if (typeof ing === 'string') return ing;
  const o = ing as { item: string; qty?: unknown; unit?: string; prep?: string; note?: string };
  return [
    o.qty != null ? String(o.qty) : '',
    o.unit ?? '',
    o.item,
    o.prep ? `(${o.prep})` : '',
    o.note ? `— ${o.note}` : '',
  ]
    .filter(Boolean)
    .join(' ');
}

const author = typeof d.author === 'string' ? { name: d.author } : d.author;
const hasGroups = groups.size > 1 || (groups.size === 1 && !groups.has(''));
---

<Base title={d.title}>
  <article>
    <h1>{d.title}</h1>

    <dl class="meta">
      <dt>From</dt>
      <dd>{countryNames}{d.region ? `, ${d.region}` : ''}</dd>
      {d.cuisine && (
        <>
          <dt>Cuisine</dt>
          <dd>{[d.cuisine, d.subcuisine].filter(Boolean).join(', ')}</dd>
        </>
      )}
      {d.difficulty && (
        <>
          <dt>Difficulty</dt>
          <dd>{d.difficulty}</dd>
        </>
      )}
      {d.servings && (
        <>
          <dt>Serves</dt>
          <dd>{d.servings}</dd>
        </>
      )}
      {d.prep_minutes && (
        <>
          <dt>Prep</dt>
          <dd>{d.prep_minutes} min</dd>
        </>
      )}
      {d.cook_minutes && (
        <>
          <dt>Cook</dt>
          <dd>{d.cook_minutes} min</dd>
        </>
      )}
    </dl>

    <aside class="locator">
      <OriginPlate
        country={d.country}
        region={d.region}
        label={`${countryNames}${d.region ? `, ${d.region}` : ''}`}
      />
    </aside>

    <h2>Ingredients</h2>
    {
      [...groups.entries()].map(([group, items]) => (
        <section>
          {hasGroups && group && <h3>{group}</h3>}
          <ul>
            {items.map((ing) => (
              <li>{ingredientText(ing)}</li>
            ))}
          </ul>
        </section>
      ))
    }

    <Content />

    <hr />
    <p class="credit">
      Contributed by{' '}
      {author?.url ? <a href={author.url}>{author.name}</a> : (author?.name ?? 'an anonymous cook')}.
      {d.source && <> Source: {d.source}.</>}
    </p>
  </article>

  <style>
    /* Drop cap on the opening instruction. The markdown paragraphs render as
       direct children of the article, so the first <p> is the start of the
       method; the brick initial marks where the reading begins. */
    article > p:first-of-type::first-letter {
      font-family: var(--display);
      float: left;
      font-size: 3.6em;
      line-height: 0.72;
      padding: 0.06em 0.1em 0 0;
      color: var(--accent);
    }

    /* Ingredient group labels are sub-heads, so small caps in the body face keeps
       them quiet beside the display-face h2s. */
    h3 {
      font-family: var(--body);
      font-variant-caps: small-caps;
      letter-spacing: 0.08em;
      font-size: 1.18rem;
      margin: 1.1rem 0 0.3rem;
      color: var(--accent);
    }
    .credit {
      font-size: 0.92rem;
      font-style: italic;
    }

    /* On wide screens the article is 42rem centred and the right margin is empty
       paper, so the locator lives there, fixed while the recipe scrolls. Below the
       threshold it stacks, right after the metadata where "where this is from"
       already sits. */
    .locator {
      margin: 1.5rem 0 0.5rem;
    }
    @media (min-width: 80rem) {
      /* Parked in the article's right margin but in normal flow, so it scrolls away
         with the recipe rather than following the reader down the page. */
      article {
        position: relative;
      }
      .locator {
        position: absolute;
        top: 0;
        left: 100%;
        margin: 0 0 0 1.5rem;
        width: 16rem;
      }
    }
  </style>
</Base>
